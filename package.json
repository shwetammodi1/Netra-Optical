{
  "name": "netra-optical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Netra Optical — premium optical store, Indore. Built with HonoX.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "assets": "node scripts/generate-images.mjs",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.10",
    "honox": "^0.1.44"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.6.2",
    "@hono/vite-dev-server": "^0.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.1.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "wrangler": "^4.42.0"
  }
}
